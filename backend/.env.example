# Copy to .env (or export in your shell). All optional - sensible defaults are built in.
# CHRONOVISION_MODEL=yolo11n.pt        # fastest on CPU. yolo11s.pt sees small objects (handbags, phones) noticeably better
# CHRONOVISION_IMGSZ=640               # 960 helps small objects, ~2x slower
# CHRONOVISION_DEVICE=cpu              # cpu | 0 (first NVIDIA GPU) | mps (Apple Silicon); default auto
# CHRONOVISION_PROCESS_FPS=10          # analysed frames per second; 5 is ~2x faster, less precise
# CHRONOVISION_CONF=0.25               # detection confidence floor (per-group minimums are in app/taxonomy.py)
# CHRONOVISION_CLASSES=                # empty = all supported classes; or COCO ids, e.g. 0,2,26
# ANTHROPIC_API_KEY=sk-ant-...         # optional: LLM-assisted query parsing (falls back to rules if unset/failing)
# CHRONOVISION_LLM_MODEL=claude-haiku-5-5
